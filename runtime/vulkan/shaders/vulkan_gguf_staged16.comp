#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_bfloat16 : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#pragma use_vulkan_memory_model
#define SPLASH_LOCAL_SIZE_DEFAULT 64
#include "common.glsl"
#include "quant.glsl"

// Port of Metal gguf_decode_tile / gguf_staged_steps / dequant32: a subgroup
// stages 32 columns, prefetches the next payload, and multiplies BF16 inputs
// by FP16 staged weights with FP32 accumulation. The target stays quantized.
layout(constant_id=3)const uint FORMAT0=0;
layout(constant_id=4)const uint FORMAT1=0;
layout(constant_id=5)const uint FORMAT2=0;
layout(constant_id=6)const uint EPILOGUE=0;
layout(constant_id=7)const bool OUTPUT_F32=false;
layout(constant_id=8)const uint INPUT_WIDTH=0;
layout(constant_id=9)const uint PLANE_WIDTH=0;
layout(constant_id=10)const uint OUTPUT_WIDTH=0;
layout(constant_id=12)const uint SEGMENTS=1;
layout(constant_id=15)const uint K_SPLITS=1;
layout(constant_id=18)const uint ACTIVE_ROWS=8;
layout(constant_id=23)const uint ROW_TILE=8;
layout(constant_id=24)const uint ROW_MATRICES=1;
layout(buffer_reference,std430,buffer_reference_align=4)readonly buffer Params {
 uint rows,input_size,out_stride,plane_input_size;
 uint cols[3],fmt[3],offset[3];
 uint epilogue,output_f32,row_start,active_rows,input_f32;
};
layout(buffer_reference,std430,buffer_reference_align=2)readonly buffer RB16 {bfloat16_t values[];};
shared float16_t weights_stage[2*2*32*32];
struct Payload {uvec4 low,extra,header;uvec2 high;uint tail;};
uint hb(Payload p,uint byte_index){return (p.header[byte_index/4]>>(8*(byte_index%4)))&255;}
uint payload_code(uint f,Payload p,uint e){
 uint slot=8*((e>>2)&3)+4*(e>>4)+(e&3),bits=f==6?8:4;
 bool pairs=f==0||f==3||f==4||(q_affine(f)&&bits==4);
 uint wi=pairs?slot/8:slot/(32/bits),word=wi<4?p.low[wi]:p.extra[wi-4];
 uint shift=pairs?4*((slot/2)%4)+16*(slot&1):bits*(slot%(32/bits));
 uint code=(word>>shift)&((1u<<bits)-1);
 if(f==4)code|=((p.high[slot/16]>>(2*(slot%16)))&3)<<4;
 if(f==3)code|=((p.high.x>>slot)&1)<<4;
 return code;
}
Payload load_payload(uint f,uint row,uint g,uint count,uint64_t w0,uint64_t w1,uint64_t meta,Payload previous,bool read_meta){
 Payload p=previous;
 if(row>=count){p.low=uvec4(0);p.extra=uvec4(0);p.high=uvec2(0);p.header=uvec4(0);p.tail=0;return p;}
 bool packed=f==0||f==1||f==2||f==3||f==4||f==6||(q_affine(f)&&q_bits(f)==4);
 uint t=q_tile32(row,g,PLANE_WIDTH/32);
 if(packed){p.low=RU32x4(w0+t*q_fields(f).x).values[0];
  if(f==6)p.extra=RU32x4(w0+t*32+16).values[0];
  if(f==4)p.high=RU32x2(w1+t*8).values[0];
  if(f==3)p.high.x=RU32(w1+t*4).values[0];
 }
 if(read_meta){uint mg=q_meta_groups(f);uint64_t at=meta+q_tile32(row,g/mg,(PLANE_WIDTH/32)/mg)*q_fields(f).z;
  uint bytes=q_fields(f).z;p.header=uvec4(0);p.tail=0;
  if(bytes>=16)p.header=RU32x4(at).values[0];else if(bytes>=8)p.header.xy=RU32x2(at).values[0];
  else if(bytes>=4)p.header.x=RU32(at).values[0];else p.header.x=uint(R16(at).values[0]);
  if(bytes==20)p.tail=RU32(at+16).values[0];
 }
 return p;
}
void dequantize_stage(uint f,Payload p,uint row,uint g,uint count,uint at,uint64_t w0,uint64_t w1,uint64_t meta){
 uint j=g%q_meta_groups(f);float scale=unpackHalf2x16(p.header.x).x,bias=0,scale_hi=scale;
 if(f==4){uint sc=(p.header[j/2]>>(16*(j&1)))&65535;float d=unpackHalf2x16(p.tail).x;
  scale=d*float(q_signed(sc&255));scale_hi=d*float(q_signed(sc>>8));
 }else if(f==0||f==3){uint sc,mi;
  if(j<4){sc=hb(p,4+j)&63;mi=hb(p,8+j)&63;}else{sc=(hb(p,8+j)&15)|((hb(p,j)>>6)<<4);mi=(hb(p,8+j)>>4)|((hb(p,4+j)>>6)<<4);}
  scale*=float(sc);bias=-unpackHalf2x16(p.header.x).y*float(mi);
 }else if(f==1){uint sc=((hb(p,4+j/2)>>(4*(j&1)))&15)|(((p.header.x>>(16+2*j))&3)<<4);scale*=float(int(sc)-32);
 }else if(q_affine(f)){scale=bf16_float(uint16_t(p.header.x));bias=bf16_float(uint16_t(p.header.x>>16));}
 [[unroll]]for(uint e=0;e<32;e+=2){
  precise vec2 value=vec2(0);
  if(row<count){
   bool packed=f==0||f==1||f==2||f==3||f==4||f==6||(q_affine(f)&&q_bits(f)==4);
   if(packed){uint c0=payload_code(f,p,e),c1=payload_code(f,p,e+1);
    if(f==6)value=scale*vec2(q_signed(c0),q_signed(c1));
    else if(f==1||f==2)value=scale*vec2(q_iq4(c0),q_iq4(c1));
    else {
     // Metal staged_linear builds exact half codes through the mantissa.
     f16vec2 code=unpackFloat2x16(c0|(c1<<16)|0x64006400u)-f16vec2(float16_t(f==4?1056:1024));
     value=f==4?vec2(code)*(e<16?scale:scale_hi):fma(vec2(code),vec2(scale),vec2(bias));
    }
   }else value=vec2(q_value(f,w0,w1,meta,row,g*32+e,PLANE_WIDTH),q_value(f,w0,w1,meta,row,g*32+e+1,PLANE_WIDTH));
  }
  f16vec2 rounded=f16vec2(value);weights_stage[at+e]=rounded.x;weights_stage[at+e+1]=rounded.y;
 }
}
void sg_barrier(){controlBarrier(gl_ScopeSubgroup,gl_ScopeSubgroup,gl_StorageSemanticsShared,gl_SemanticsAcquireRelease);}
void main(){
 Params p=Params(binding_address(12));uint lane=gl_SubgroupInvocationID,sg=gl_SubgroupID;
 uint t0=(p.cols[0]+63)/64,t1=t0+(p.cols[1]+63)/64,tile=gl_WorkGroupID.x;
 uint segment=SEGMENTS==1?0:tile<t0?0:tile<t1?1:2;
 uint column=(tile-(segment==0?0:segment==1?t0:t1))*64+sg*32,base=gl_WorkGroupID.y*ROW_TILE;
 if(column>=p.cols[segment])return;
 uint f=segment==0?FORMAT0:segment==1?FORMAT1:FORMAT2;
 uint64_t w0=binding_address(1+segment*3),w1=binding_address(2+segment*3),meta=binding_address(3+segment*3);
 coopmat<float,gl_ScopeSubgroup,16,16,gl_MatrixUseAccumulator> acc[ROW_MATRICES*2];
 [[unroll]]for(uint i=0;i<ROW_MATRICES*2;++i)acc[i]=coopmat<float,gl_ScopeSubgroup,16,16,gl_MatrixUseAccumulator>(0.0);
 Payload packed;packed.low=uvec4(0);packed.extra=uvec4(0);packed.header=uvec4(0);packed.high=uvec2(0);packed.tail=0;
 uint split=gl_WorkGroupID.z,units=(INPUT_WIDTH+255)/256;
 uint begin=units*split/K_SPLITS*8,end=min(units*(split+1)/K_SPLITS*8,INPUT_WIDTH/32);
 packed=load_payload(f,column+lane,begin,p.cols[segment],w0,w1,meta,packed,true);
 for(uint g=begin;g<end;++g){
  uint at=sg*2048+(g&1)*1024;
  dequantize_stage(f,packed,column+lane,g,p.cols[segment],at+lane*32,w0,w1,meta);
  sg_barrier();
  if(g+1<end)packed=load_payload(f,column+lane,g+1,p.cols[segment],w0,w1,meta,packed,(g+1)/q_meta_groups(f)!=g/q_meta_groups(f));
  [[unroll]]for(uint step=0;step<2;++step){
   [[unroll]]for(uint rm=0;rm<ROW_MATRICES;++rm){
    coopmat<bfloat16_t,gl_ScopeSubgroup,16,16,gl_MatrixUseA>a;
    [[unroll]]for(uint i=0;i<8;++i){uint row=((lane&6)|((lane>>1)&8)|(i>>2))+rm*16;
     uint k=((lane>>3)&1)|((lane&1)<<3)|((i&3)<<1);
     a[i]=base+row<p.rows&&row<ROW_TILE&&row%8<ACTIVE_ROWS?RB16(binding_address(0)).values[(base+row+p.row_start)*INPUT_WIDTH+g*32+step*16+k]:bfloat16_t(0);
    }
    [[unroll]]for(uint nc=0;nc<2;++nc){
     coopmat<float16_t,gl_ScopeSubgroup,16,16,gl_MatrixUseB>b;
     coopMatLoad(b,weights_stage,at+nc*16*32+step*16,32,gl_CooperativeMatrixLayoutColumnMajor);
     acc[rm*2+nc]=coopMatMulAdd(a,b,acc[rm*2+nc]);
    }
   }
  }
 }
 [[unroll]]for(uint rm=0;rm<ROW_MATRICES;++rm)[[unroll]]for(uint nc=0;nc<2;++nc)[[unroll]]for(uint i=0;i<8;++i){
  uint row=((lane&6)|((lane>>1)&8)|(i>>2))+rm*16,col=column+nc*16+((lane&1)<<2)+(lane&8)+(i&3);
  if(base+row>=p.rows||row>=ROW_TILE||col>=p.cols[segment])continue;
  uint index=(base+row+p.row_start)*OUTPUT_WIDTH+p.offset[segment]+col;float value=acc[rm*2+nc][i];
  if(K_SPLITS>1){WF32(binding_address(15)).values[(split*p.rows+base+row)*OUTPUT_WIDTH+p.offset[segment]+col]=row%8<ACTIVE_ROWS?value:0.0;continue;}
  if(EPILOGUE==1)value+=bf16_float(R16(binding_address(11)+2*index).values[0]);
  if(EPILOGUE==2){float gate=bf16_float(R16(binding_address(11)+2*index).values[0]);value=bf16_float(float_bf16(value))*(gate/(1.0+exp2(-1.44269504089*gate)));}
  if(row%8>=ACTIVE_ROWS)value=0;
  if(OUTPUT_F32)WF32(binding_address(10)+4*index).values[0]=value;else W16(binding_address(10)+2*index).values[0]=float_bf16(value);
 }
}
