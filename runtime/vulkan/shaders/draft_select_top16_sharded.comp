#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#include "draft_common.glsl"
// Port of upstream sampling.metal: static sorted insert, chunk threshold,
// vector logits reads, and double-buffered shared list-head merge.
layout(buffer_reference,std430,buffer_reference_align=16) readonly buffer LogitVectors {vec4 values[];};
shared float maxima[256],thresholds[8],round_values[2][8];
shared uint round_ids[2][8];
bool beats(float value,uint token,float other,uint other_token){
 return value>other||(value==other&&token<other_token);
}
void insert16(inout float values[16],inout uint ids[16],float value,uint token){
 [[unroll]] for(uint slot=15;slot>0;--slot){
  bool here=beats(value,token,values[slot],ids[slot]);
  bool above=beats(value,token,values[slot-1],ids[slot-1]);
  values[slot]=here?(above?values[slot-1]:value):values[slot];
  ids[slot]=here?(above?ids[slot-1]:token):ids[slot];
 }
 bool top=beats(value,token,values[0],ids[0]);
 values[0]=top?value:values[0];ids[0]=top?token:ids[0];
}
void pop16(inout float values[16],inout uint ids[16]){
 [[unroll]] for(uint slot=0;slot<15;++slot){values[slot]=values[slot+1];ids[slot]=ids[slot+1];}
 values[15]=-1.0/0.0;ids[15]=0xffffffffu;
}
void main(){
 uint group=gl_WorkGroupID.x,thread=gl_LocalInvocationIndex;
 uint lane=gl_SubgroupInvocationID,sg=gl_SubgroupID;
 uint vocab=RU32(binding_address(3)).values[0];
 uint batch=group/56,position=group%56/8,shard=group%8;
 uint row_start=(batch*8+position+1)*vocab;
 uint span=(vocab+7)/8,begin=min(shard*span,vocab),end=min(begin+span,vocab);
 uint head=min((4-(row_start+begin)%4)%4,end-begin);
 uint vectors=(end-begin-head)/4,vector_begin=begin+head,tail_begin=vector_begin+vectors*4;
 uint64_t row=binding_address(0)+uint64_t(row_start)*4;
 LogitVectors vector_row=LogitVectors(row+uint64_t(vector_begin)*4);
 float values[16];uint ids[16];
 [[unroll]] for(uint i=0;i<16;++i){values[i]=-1.0/0.0;ids[i]=0xffffffffu;}
 if(thread<head){uint token=begin+thread;float value=RF32(row).values[token];
  if(beats(value,token,values[15],ids[15]))insert16(values,ids,value,token);}
 if(thread<end-tail_begin){uint token=tail_begin+thread;float value=RF32(row).values[token];
  if(beats(value,token,values[15],ids[15]))insert16(values,ids,value,token);}
 for(uint chunk=0;chunk<vectors;chunk+=256*16){
  vec4 loaded[16];float best=-1.0/0.0;
  [[dont_unroll]] for(uint i=0;i<16;++i){
   uint index=chunk+thread+i*256;
   loaded[i]=index<vectors?vector_row.values[index]:vec4(0);
   if(index<vectors) [[unroll]] for(uint j=0;j<4;++j)if(loaded[i][j]>best)best=loaded[i][j];
  }
  maxima[thread]=best;barrier();
  uint above=0;[[dont_unroll]] for(uint other=0;other<256;++other)above+=maxima[other]>best?1u:0u;
  float candidate=subgroupMin(above<16?best:1.0/0.0);
  if(lane==0)thresholds[sg]=candidate;barrier();
  float threshold=thresholds[0];for(uint other=1;other<8;++other)threshold=min(threshold,thresholds[other]);
  [[dont_unroll]] for(uint i=0;i<16;++i){
   uint index=chunk+thread+i*256;
   if(index>=vectors)continue;
   uint token=vector_begin+index*4;
   [[unroll]] for(uint j=0;j<4;++j){
    float value=loaded[i][j];
    if(value>=threshold&&beats(value,token+j,values[15],ids[15]))insert16(values,ids,value,token+j);
   }
  }
 }
 [[dont_unroll]] for(uint rank=0;rank<16;++rank){
  float head_value=values[0];uint head_id=ids[0];
  float simd_value=subgroupMax(head_value);
  uint simd_id=subgroupMin(head_value==simd_value?head_id:0xffffffffu),slot=rank&1;
  if(lane==0){round_values[slot][sg]=simd_value;round_ids[slot][sg]=simd_id;}barrier();
  float best=round_values[slot][0];uint best_id=round_ids[slot][0];
  for(uint other=1;other<8;++other){float value=round_values[slot][other];uint token=round_ids[slot][other];
   if(beats(value,token,best,best_id)){best=value;best_id=token;}}
  if(thread==rank){WU32(binding_address(1)).values[group*16+rank]=best_id;WF32(binding_address(2)).values[group*16+rank]=best;}
  if(head_value==best&&head_id==best_id)pop16(values,ids);
 }
}
