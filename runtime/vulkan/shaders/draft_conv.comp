#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#include "draft_common.glsl"
layout(constant_id=3) const uint HIDDEN=5120;
void main(){uint i=gl_GlobalInvocationID.x,batch=gl_WorkGroupID.y;if(i>=8*HIDDEN)return;
 uint row=i/HIDDEN,ch=i%HIDDEN,groups=HIDDEN/16,dynamic=4*groups,kind=RU32(binding_address(5)).values[0];
 uint64_t inputa=binding_address(0)+uint64_t(batch)*8*HIDDEN*2,da=binding_address(1)+uint64_t(batch)*8*dynamic*2;
 float v=rb(inputa,i)*(rb(binding_address(2),kind*2*HIDDEN+ch)+rb(da,row*dynamic+kind*2*groups+ch/16));
 if(row>0)v+=rb(inputa,i-HIDDEN)*(rb(binding_address(2),(kind*2+1)*HIDDEN+ch)+rb(da,row*dynamic+(kind*2+1)*groups+ch/16));
 if(kind!=0)v+=rb(binding_address(3),batch*8*HIDDEN+i);wb(binding_address(4),batch*8*HIDDEN+i,v);}
