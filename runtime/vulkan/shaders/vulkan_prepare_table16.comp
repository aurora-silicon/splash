#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#define SPLASH_LOCAL_SIZE_DEFAULT 256
#include "common.glsl"
layout(buffer_reference,std430,buffer_reference_align=4)readonly buffer Params {
 uint rows,input_size,out_stride,plane_input_size;uint cols[3],fmt[3],offset[3];
 uint epilogue,output_f32,row_start,active_rows,input_f32;
};
uint table_index(uint row,uint k){uint lane=(k&6)|((k&8)<<1)|((row&4)>>2)|(row&8),i=((k&1)<<2)|(row&3);return lane*8+i;}
void main(){
 Params p=Params(binding_address(12));uint tid=gl_LocalInvocationID.x,row=tid/16,pair_index=tid%16,base=gl_WorkGroupID.y*16,g=gl_WorkGroupID.x;
 uint pair=0;if(base+row<p.rows&&row%8<p.active_rows)pair=RU32(binding_address(0)+2*((base+row+p.row_start)*p.input_size+g*32+2*pair_index)).values[0];
 uint16_t a=uint16_t(pair),b=uint16_t(pair>>16);uint h=pair_index/8,k=(pair_index%8)*2;
 uint offset=gl_WorkGroupID.y*p.input_size*16+(g*2+h)*256;
 W16(binding_address(13)).values[offset+table_index(row,k)]=a;W16(binding_address(13)).values[offset+table_index(row,k+1)]=b;
 precise float sum=bf16_float(a)+bf16_float(b);sum+=subgroupShuffleXor(sum,1);sum+=subgroupShuffleXor(sum,2);sum+=subgroupShuffleXor(sum,4);
 uint sums_base=gl_WorkGroupID.y*(p.input_size/16*16+p.input_size/32*16);
 if((pair_index&7)==0)WF32(binding_address(14)).values[sums_base+(g*2+h)*16+row]=-160.0*sum;
 precise float s32=sum+subgroupShuffleXor(sum,8);
 if(pair_index==0)WF32(binding_address(14)).values[sums_base+p.input_size/16*16+g*16+row]=s32;
}
