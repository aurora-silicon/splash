    }
    dot0=coopMatMulAdd(a0,b,dot0);dot1=coopMatMulAdd(a1,b,dot1);
   }
   vec2 coef0=group_coefficient(hdr0,j,d0),coef1=group_coefficient(hdr1,j,d1);
   total0=fma(vec2(dot0[0],dot0[1]),vec2(coef0.x),total0);total1=fma(vec2(dot1[0],dot1[1]),vec2(coef1.x),total1);
   if(FORMAT0==0||FORMAT0==3||q_affine(FORMAT0)){
    vec2 sum=RF32x4(binding_address(14)+4*(sums_base+INPUT_WIDTH/16*8+g*8+n)).values[0].xy;
    total0=fma(sum,vec2(coef0.y),total0);total1=fma(sum,vec2(coef1.y),total1);
   }
  }
 }
 finish(p,segment,column,base,m,n,split,total0,total1);
}
