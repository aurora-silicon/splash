#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#include "attention_common.glsl"
shared float sums[8],normalized[256];
void main(){uint batch=VERIFY?gl_WorkGroupID.y:0,tokens=VERIFY?8:RU32(binding_address(8)).values[0],stride=VERIFY?32:RU32(binding_address(8)).values[1];
 uint task=gl_WorkGroupID.x,i=gl_LocalInvocationIndex;bool query=task<tokens*QH;uint lt=query?task:task-tokens*QH,heads=query?QH:KH,row=lt/heads,h=lt%heads;
 uint packedStride=(2*QH+2*KH)*256,src=(batch*tokens+row)*packedStride+(query?h*512:QH*512+h*256);
 float x=rb(binding_address(0),src+i),s=subgroupAdd(x*x);if(gl_SubgroupInvocationID==0)sums[gl_SubgroupID]=s;barrier();
 if(i==0){float sum=0;for(uint j=0;j<8;++j)sum+=sums[j];sums[0]=inversesqrt(sum/256.0+1e-6);}barrier();
 uint64_t weight=binding_address(query?1:2);float w=NORM_F32?RF32(weight).values[i]:rb(weight,i);normalized[i]=bf16_float(float_bf16(x*sums[0]*w));
 if(!query)wb(binding_address(7),((batch*KH+h)*256+i)*stride+row,rb(binding_address(0),src+KH*256+i));barrier();
 uint dst=query?(((batch*KH+h/(QH/KH))*stride+row)*(QH/KH)+h%(QH/KH))*256:((batch*KH+h)*stride+row)*256;
 uint64_t outa=binding_address(query?5:6);
 if(i<32){float a=normalized[i],b=normalized[i+32],c=RF32(binding_address(3)).values[(batch*tokens+row)*32+i],sine=RF32(binding_address(4)).values[(batch*tokens+row)*32+i];wb(outa,dst+i,a*c-b*sine);wb(outa,dst+i+32,b*c+a*sine);}else if(i>=64)wb(outa,dst+i,normalized[i]);
}
