#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#include "quant.glsl"
layout(constant_id = 3) const uint FORMAT = 0;
void main() {
    uint width = RU32(binding_address(4)).values[0];
    uint rows = RU32(binding_address(4)).values[2];
    uint i = gl_GlobalInvocationID.x;
    if (i >= width * rows) return;
    WF32(binding_address(3) + uint64_t(i) * 4).values[0] =
        q_value(FORMAT, binding_address(0), binding_address(1), binding_address(2), i / width, i % width, width);
}
