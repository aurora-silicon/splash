shared bfloat16_t code_lut[256];
vec2 group_coefficient(uvec4 header,uint j,float d){
 if(FORMAT0==6||FORMAT0==2)return vec2(d,0);
 if(FORMAT0==1){uint sc=((header.y>>(4*j))&15)|(((header.x>>(16+2*j))&3)<<4);return vec2(unpackHalf2x16(header.x).x*float(int(sc)-32),0);}
 if(q_affine(FORMAT0)){float scale=bf16_float(uint16_t(header.x));return vec2(scale,fma(-128.0,scale,bf16_float(uint16_t(header.x>>16))));}
 uint sc,mi;
 if(j<4){sc=(header.y>>(8*j))&63;mi=(header.z>>(8*j))&63;}
 else{uint shift=8*(j-4),w=header.w>>shift;sc=(w&15)|(((header.y>>(shift+6))&3)<<4);mi=((w>>4)&15)|(((header.z>>(shift+6))&3)<<4);}
 vec2 ds=unpackHalf2x16(header.x);float scale=ds.x*float(sc);
 return vec2(scale,fma(-128.0,scale,-ds.y*float(mi)));
}

void main(){
 if(FORMAT0==6||FORMAT0==1||FORMAT0==2){
  uint count=FORMAT0==6?256:16;
  for(uint i=gl_LocalInvocationID.x;i<count;i+=gl_WorkGroupSize.x)code_lut[i]=bfloat16_t(FORMAT0==6?float(q_signed(i)):q_iq4(i));
  barrier();
 }
 Params p=linear_params();uint lane=gl_SubgroupInvocationID,m=((lane>>1)&3)|((lane>>2)&4),n=((lane&1)<<1)|((lane>>1)&4),chunk=n/2;
 uint tile=gl_WorkGroupID.x,cpg=16*gl_NumSubgroups,t0=(p.cols[0]+cpg-1)/cpg,t1=t0+(p.cols[1]+cpg-1)/cpg;
 uint segment=SEGMENTS==1?0:tile<t0?0:tile<t1?1:2;
 uint column=(tile-(segment==0?0:segment==1?t0:t1))*cpg+gl_SubgroupID*16,base=gl_WorkGroupID.y*8;
 bool valid0=FULL_COLUMNS||column+m<p.cols[segment],valid1=FULL_COLUMNS||column+8+m<p.cols[segment];
 uint64_t w0=binding_address(1+3*segment),w1=binding_address(2+3*segment),meta=binding_address(3+3*segment);
 vec2 total0=vec2(0),total1=vec2(0);
 uint table_base=(base/8)*INPUT_WIDTH*8,sums_base=(base/8)*(INPUT_WIDTH/16*8+INPUT_WIDTH/32*8);
 uint split=gl_WorkGroupID.z,units=(INPUT_WIDTH+255)/256;
 const uint metaBytes=q_fields(FORMAT0).z;
 for(uint unit=units*split/K_SPLITS*256;unit<units*(split+1)/K_SPLITS*256;unit+=256){
  uint mt0=q_tile32(column+m,unit/256,PLANE_WIDTH/256),mt1=q_tile32(column+8+m,unit/256,PLANE_WIDTH/256);
  uvec4 hdr0=uvec4(0),hdr1=uvec4(0);
  if(q_meta_groups(FORMAT0)==8){
   if(valid0){if(metaBytes>=16)hdr0=RU32x4(meta+mt0*metaBytes).values[0];else hdr0.xy=RU32x2(meta+mt0*metaBytes).values[0];}
   if(valid1){if(metaBytes>=16)hdr1=RU32x4(meta+mt1*metaBytes).values[0];else hdr1.xy=RU32x2(meta+mt1*metaBytes).values[0];}
  }
  [[unroll]]for(uint j=0;j<8&&unit+j*32<INPUT_WIDTH;++j){
   uint g=unit/32+j,t0=q_tile32(column+m,g,PLANE_WIDTH/32),t1=q_tile32(column+8+m,g,PLANE_WIDTH/32);
   uvec2 low0=uvec2(0),low1=uvec2(0);uint high0=0,high1=0;float d0=0,d1=0;
   if(valid0){
    if(FORMAT0==6)low0=RU32x2(w0+t0*32+8*chunk).values[0];else low0.x=RU32(w0+t0*16+4*chunk).values[0];
    if(FORMAT0==3)high0=RU32(w1+t0*4).values[0];
   }
   if(valid1){
    if(FORMAT0==6)low1=RU32x2(w0+t1*32+8*chunk).values[0];else low1.x=RU32(w0+t1*16+4*chunk).values[0];
    if(FORMAT0==3)high1=RU32(w1+t1*4).values[0];
   }
   if(FORMAT0==6||FORMAT0==2){d0=valid0?q_half(meta+t0*2):0;d1=valid1?q_half(meta+t1*2):0;}
   if(q_affine(FORMAT0)){
    uint mg=q_meta_groups(FORMAT0),m0=q_tile32(column+m,g/mg,PLANE_WIDTH/32/mg),m1=q_tile32(column+8+m,g/mg,PLANE_WIDTH/32/mg);
    hdr0.x=valid0?RU32(meta+m0*4).values[0]:0;hdr1.x=valid1?RU32(meta+m1*4).values[0]:0;
   }
   uvec4 input_pairs=RU32x4(binding_address(13)+2*(table_base+(g/2)*512+((g%2*8+m)*4+chunk)*8)).values[0];
   MC dot0=MC(0.0),dot1=MC(0.0);
   [[unroll]]for(uint f=0;f<4;++f){
    MA a0,a1;MB b;
    [[unroll]]for(uint i=0;i<2;++i){
     uint c0,c1;
     if(FORMAT0==6){uint shift=8*(2*(f&1)+i);c0=(low0[f>>1]>>shift)&255;c1=(low1[f>>1]>>shift)&255;}
     else if(FORMAT0==1||FORMAT0==2){uint shift=4*(2*f+i);c0=(low0.x>>shift)&15;c1=(low1.x>>shift)&15;}
     else{uint shift=4*f+16*i;c0=(low0.x>>shift)&15;c1=(low1.x>>shift)&15;}
