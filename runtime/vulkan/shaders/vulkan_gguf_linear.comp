#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_shuffle : require
#include "common.glsl"
#include "quant.glsl"

layout(constant_id = 3) const uint FORMAT0 = 0;
layout(constant_id = 4) const uint FORMAT1 = 0;
layout(constant_id = 5) const uint FORMAT2 = 0;
layout(constant_id = 6) const uint EPILOGUE = 0;
layout(constant_id = 7) const bool OUTPUT_F32 = false;
layout(constant_id = 8) const uint INPUT_WIDTH = 0;
layout(constant_id = 9) const uint PLANE_WIDTH = 0;
layout(constant_id = 10) const uint OUTPUT_WIDTH = 0;
layout(constant_id = 11) const bool FULL_ROWS = false;
layout(constant_id = 12) const uint SEGMENTS = 1;
layout(constant_id = 13) const bool FULL_COLUMNS = false;
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer Params {
    uint rows;
    uint input_size;
    uint out_stride;
    uint plane_input_size;
    uint cols[3];
    uint fmt[3];
    uint offset[3];
    uint epilogue;
    uint output_f32;
    uint row_start;
    uint active_rows;
    uint input_f32;
};
float weight_at(uint segment, uint row, uint column) {
    if (SEGMENTS == 1 || segment == 0) return q_value(FORMAT0, binding_address(1), binding_address(2), binding_address(3), row, column, PLANE_WIDTH);
    if (segment == 1) return q_value(FORMAT1, binding_address(4), binding_address(5), binding_address(6), row, column, PLANE_WIDTH);
    return q_value(FORMAT2, binding_address(7), binding_address(8), binding_address(9), row, column, PLANE_WIDTH);
}

void main() {
    Params p = Params(binding_address(12));
    uint lane = gl_SubgroupInvocationID, matrix_row = lane / 4, pair = lane % 4;
    uint tile = gl_WorkGroupID.x;
    uint t0 = (p.cols[0] + 15) / 16, t1 = t0 + (p.cols[1] + 15) / 16;
    uint segment = SEGMENTS == 1 ? 0 : tile < t0 ? 0 : tile < t1 ? 1 : 2;
    uint local_tile = tile - (segment == 0 ? 0 : segment == 1 ? t0 : t1);
    uint column = local_tile * 16 + 2 * pair;
    uint row_base = gl_WorkGroupID.y * 8;
    vec4 accum = vec4(0.0);
    for (uint begin = 0; begin < INPUT_WIDTH; begin += 8) {
        uint k = begin + matrix_row, source_row = row_base + 2 * pair;
        float a0 = 0.0, a1 = 0.0;
        if (FULL_ROWS || source_row < p.rows)
            a0 = bf16_float(R16(binding_address(0) + 2 * (uint64_t(source_row + p.row_start) * INPUT_WIDTH + k)).values[0]);
        if (FULL_ROWS || source_row + 1 < p.rows)
            a1 = bf16_float(R16(binding_address(0) + 2 * (uint64_t(source_row + 1 + p.row_start) * INPUT_WIDTH + k)).values[0]);
        float b0 = FULL_COLUMNS || column < p.cols[segment] ? weight_at(segment, column, k) : 0.0;
        float b1 = FULL_COLUMNS || column + 1 < p.cols[segment] ? weight_at(segment, column + 1, k) : 0.0;
        float b2 = FULL_COLUMNS || column + 8 < p.cols[segment] ? weight_at(segment, column + 8, k) : 0.0;
        float b3 = FULL_COLUMNS || column + 9 < p.cols[segment] ? weight_at(segment, column + 9, k) : 0.0;
        [[unroll]] for (uint i = 0; i < 8; ++i) {
            uint from_a = 4 * i + matrix_row / 2, from_b = 4 * i + pair;
            float x0 = subgroupShuffle(a0, from_a), x1 = subgroupShuffle(a1, from_a);
            float x = (matrix_row & 1) == 0 ? x0 : x1;
            accum.x = fma(x, subgroupShuffle(b0, from_b), accum.x);
            accum.y = fma(x, subgroupShuffle(b1, from_b), accum.y);
            accum.z = fma(x, subgroupShuffle(b2, from_b), accum.z);
            accum.w = fma(x, subgroupShuffle(b3, from_b), accum.w);
        }
    }
    uint row = row_base + matrix_row;
    if (!FULL_ROWS && row >= p.rows) return;
    [[unroll]] for (uint i = 0; i < 4; ++i) {
        uint c = column + (i / 2) * 8 + i % 2;
        if (!FULL_COLUMNS && c >= p.cols[segment]) continue;
        float value = accum[i];
        uint64_t index = uint64_t(row + p.row_start) * OUTPUT_WIDTH + p.offset[segment] + c;
        if (EPILOGUE == 1) value += bf16_float(R16(binding_address(11) + 2 * index).values[0]);
        if (EPILOGUE == 2) {
            float gate = bf16_float(R16(binding_address(11) + 2 * index).values[0]);
            value = bf16_float(float_bf16(value)) * (gate / (1.0 + exp2(-1.44269504089 * gate)));
        }
        if (OUTPUT_F32) WF32(binding_address(10) + 4 * index).values[0] = value;
        else W16(binding_address(10) + 2 * index).values[0] = float_bf16(value);
    }
}
